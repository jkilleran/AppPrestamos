# -----------------------------------------------------------------------------
# Aplicacion local
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Origenes web permitidos, separados por coma. Para Safari/iPhone, agrega aqui
# http://<IP-LAN-DE-LA-MAC>:7357 ademas de los origenes locales.
CORS_ORIGINS=http://localhost:7357,http://127.0.0.1:7357

# Obligatorio. Genera un valor local largo, por ejemplo con:
# openssl rand -base64 48
JWT_SECRET=

# -----------------------------------------------------------------------------
# PostgreSQL local
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/appprestamos_local
DB_SSL_DISABLED=1
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=8000
DB_SLOW_QUERY_MS=400
DB_LOG_ALL=0
DEBUG_DB_TUNING=0

# -----------------------------------------------------------------------------
# Autenticacion y diagnostico
# -----------------------------------------------------------------------------
AUTH_DEBUG=0
AUTH_OMIT_FOTO=0
LOG_REQUESTS=0
DEBUG_ROUTES=0
LOG_SIGNATURES=0
NOTIFIER_DEBUG=0

# -----------------------------------------------------------------------------
# Correo: deshabilitado para la prueba local inicial
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FORCE_IPV4=0
SMTP_CONN_TIMEOUT=12000
SMTP_SOCKET_TIMEOUT=20000
SMTP_GREETING_TIMEOUT=10000
SMTP_HARD_TIMEOUT=25000

SMTP_ENABLE_FALLBACK=0
SMTP_FORCE_FALLBACK=0
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=465
SMTP_FALLBACK_SECURE=true

DOCUMENT_TARGET_EMAIL=
DEFAULT_TARGET_EMAIL=
DOCUMENT_FROM_EMAIL=
MAIL_FROM=
FORCED_FALLBACK_FROM=1
EMAIL_MONITOR_BCC=

# Proveedor HTTP de correo deshabilitado. Si se habilita SendGrid durante
# pruebas, conserva EMAIL_HTTP_SANDBOX=1 hasta validar la configuracion.
EMAIL_HTTP_PROVIDER=
SENDGRID_API_KEY=
EMAIL_HTTP_FORCE=0
EMAIL_HTTP_SANDBOX=1
EMAIL_HTTP_DEBUG=0

EMAIL_ASYNC=0
EMAIL_ASYNC_ON_FAIL=0
EMAIL_SOFT_FAIL=0
EMAIL_OUTBOX=0
EMAIL_OUTBOX_DISABLED=1
EMAIL_OUTBOX_DEBUG=0
EMAIL_BATCH_SIZE=10
EMAIL_MAX_ATTEMPTS=5
EMAIL_WORKER_INTERVAL_MS=12000

# -----------------------------------------------------------------------------
# Push, cargas y herramientas de red: deshabilitados por defecto
# -----------------------------------------------------------------------------
FCM_SERVER_KEY=
AUTO_UPDATE_DOCUMENT_STATUS=0
RESTRICT_UPLOAD_MIME=1
UPLOAD_DEBUG=0
OUTBOUND_SCAN_ENABLED=0
OUTBOUND_SCAN_TIMEOUT=5000

# Cloudinary no esta conectado a las rutas activas y no se configura aqui.
